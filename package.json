{
  "name": "ecogeo-card",
  "version": "1.1.1",
  "private": true,
  "description": "Lovelace card for Ecoforest ecoGEO heat pumps: the unit's internal schematic with live values",
  "type": "module",
  "engines": {
    "node": "^22.13 || ^24 || >=26"
  },
  "scripts": {
    "dev": "vite --open /dev/index.html",
    "build": "vite build",
    "release": "npm run check && npm run build && node scripts/check-release.mjs",
    "verify-dist": "vite build && node scripts/check-release.mjs --verify-dist",
    "test": "vitest run --project unit --project browser",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:visual": "vitest run --project visual",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "capture": "node scripts/capture.mjs",
    "measure-layout": "node scripts/measure-layout.mjs",
    "search-places": "node scripts/search-places.mjs",
    "lint:ha": "node scripts/lint-ha.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run lint:ha && npm test"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^21.0.1",
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "^5.1.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.1",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  }
}
